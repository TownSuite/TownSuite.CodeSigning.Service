<Project>
  <PropertyGroup>
    <AssemblyVersion>26.10.9</AssemblyVersion>
    <FileVersion>26.10.9</FileVersion>
    <Version>26.10.9</Version>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>TownSuite Municipal Software Inc.</Company>
    <Product>TownSuite Code Signing</Product>
    <Copyright>Copyright © TownSuite Municipal Software Inc. 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <!-- On Jenkins, AUTOCONFIGURE_NUGET writes a NuGet config that restores through the local ProGet cache. -->
  <PropertyGroup Condition=" '$(NUGET_CONFIG_FILE)' != '' ">
    <RestoreConfigFile>$(NUGET_CONFIG_FILE)</RestoreConfigFile>
  </PropertyGroup>
</Project>
